# Copie este archivo como .env y complete los valores. NUNCA suba el .env al repositorio.
# Qdrant Cloud → cloud.qdrant.io → su clúster → "Cluster URL" y "API Keys"
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=pegue-aqui-su-api-key-de-qdrant
# Google AI Studio → aistudio.google.com/apikey
GOOGLE_API_KEY=pegue-aqui-su-api-key-de-google
# Modelo de embeddings: gemini-embedding-2 (por defecto) o gemini-embedding-001 (usa task_type=RETRIEVAL_QUERY)
GEMINI_EMBED_MODEL=gemini-embedding-2
